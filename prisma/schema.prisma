generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id
  name               String
  email              String
  emailVerified      Boolean    @default(false)
  image              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  sessions           Session[]
  accounts           Account[]
  roleId             String?
  role               Role?      @relation(fields: [roleId], references: [id])
  twoFactorEnabled   Boolean    @default(false)
  twoFactor          TwoFactor?
  /// True when an admin set this account's current password directly
  /// (new staff accounts — see createStaffAccount) rather than the
  /// user choosing it themselves. Forces a password change on next
  /// sign-in; cleared once they do. Never set retroactively on
  /// existing accounts.
  mustChangePassword Boolean    @default(false)

  @@unique([email])
  @@map("user")
}

/// A staff access-control role. Permissions are stored as data
/// (RolePermission rows), not defined in code, so staff can create and
/// edit roles from /admin/staff without a deploy.
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("role")
}

/// One (resource, action) grant for a Role — e.g. ("vendor_submissions",
/// "archive"). See src/lib/permissions.ts for the resource/action vocabulary.
model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  action   String

  @@unique([roleId, resource, action])
  @@map("role_permission")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Per-user TOTP enrollment for the two-factor plugin (opt-in — see
/// src/lib/auth.ts). One row per enrolled user; `verified` is false
/// until the enrollment's first code is confirmed.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@unique([userId])
  @@map("two_factor")
}

enum SubmissionStatus {
  NEW
  REVIEWED
  CONTACTED
  DECLINED
}

/// Staff-editable overlay for the descriptive/contact content of a
/// property. Once a row exists for a propertySlug, it is the full source
/// of truth for its fields (not a per-field fallback to the static
/// src/data/properties.ts values) so that clearing a field in the admin
/// UI actually clears it instead of resurrecting old code-managed copy.
model PropertyContent {
  propertySlug          String   @id
  description           String?
  amenities             String[]
  incomeLimits          Json?
  requiredDocuments     String[]
  applyUrl              String?
  contactName           String?
  contactPhone          String?
  contactEmail          String?
  /// Per-property resident portal link (pay rent, etc.) — shown on
  /// the public /residents page. No static-data equivalent, unlike
  /// applyUrl.
  residentPortalUrl     String?
  /// Market-rate properties only — shows a "Join the waitlist" signup
  /// on the public site instead of (well, alongside) the regular
  /// contact form when a unit is WAITLIST/FULL. Off by default.
  waitlistSignupEnabled Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  @@map("property_content")
}

/// Staff-uploaded property photos (Vercel Blob). Any rows for a
/// propertySlug make the database the full photo set for that property;
/// zero rows falls back to the static photos array.
model PropertyPhoto {
  id           String   @id @default(cuid())
  propertySlug String
  url          String
  sortOrder    Int
  createdAt    DateTime @default(now())

  @@index([propertySlug])
  @@map("property_photo")
}

/// Shared, staff-uploaded documents (Vercel Blob), keyed by a fixed slug
/// rather than per-property — e.g. the one rental application form used
/// across all affordable-housing properties.
model SiteDocument {
  key       String   @id
  url       String
  fileName  String
  updatedAt DateTime @updatedAt

  @@map("site_document")
}

model VendorSubmission {
  id             String           @id @default(cuid())
  companyName    String
  contactName    String
  email          String
  phone          String?
  serviceType    String
  message        String
  attachmentUrl  String?
  attachmentName String?
  status         SubmissionStatus @default(NEW)
  internalNote   String?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@map("vendor_submission")
}

enum UnitAvailabilityStatus {
  AVAILABLE
  WAITLIST
  FULL
  CONTACT
}

/// Staff-editable overlay for the operationally volatile parts of a unit
/// (rent/availability/status). Unit *types* still come from the static
/// Property data in src/data/properties.ts — this only tracks per-unit-type
/// state for properties already defined there.
model UnitAvailability {
  id           String                 @id @default(cuid())
  propertySlug String
  unitType     String
  status       UnitAvailabilityStatus @default(CONTACT)
  rent         String?
  availability String?
  updatedAt    DateTime               @updatedAt

  @@unique([propertySlug, unitType])
  @@index([propertySlug])
  @@map("unit_availability")
}

/// Submissions from the general contact form (/contact) and the
/// per-property contact form (/properties/[slug]/contact). propertySlug/
/// propertyName are null for a general inquiry.
model ContactSubmission {
  id               String           @id @default(cuid())
  name             String
  email            String
  phone            String?
  message          String
  propertySlug     String?
  propertyName     String?
  preferredContact String?
  status           SubmissionStatus @default(NEW)
  internalNote     String?
  /// True for a "notify me" waitlist signup (see the waitlist route
  /// and PropertyContent.waitlistSignupEnabled) rather than a regular
  /// inquiry submitted through a contact form. Always has propertySlug
  /// set, so it's covered by the same property_contact_submissions
  /// permission as any other per-property submission.
  isWaitlistSignup Boolean          @default(false)
  /// Which unit type a waitlist signup is for (null otherwise) —
  /// signup is scoped per unit type, not the whole property.
  unitType         String?
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@map("contact_submission")
}
