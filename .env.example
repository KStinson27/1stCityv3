# Copy to .env.local and fill in for local development.
# Without these set, the vendor and property-contact forms still work —
# submissions are logged to the server console instead of emailed.

# Resend (https://resend.com) API key used to email new vendor proposals
# and property inquiries to staff. See PLAN.md §2.
RESEND_API_KEY=

# Where vendor proposal notifications are sent when RESEND_API_KEY is set.
VENDOR_NOTIFICATION_EMAIL=vendors@1stcityllc.example
