# Copy to .env.local and fill in for local development.

# --- Optional — used for the sitemap, robots.txt, and social preview links ---

# The site's public URL (no trailing slash). Without it, this falls back to
# Vercel's own preview/production URL automatically, then to localhost — see
# src/lib/site.ts. Set this once a real domain is chosen (see PLAN.md §8).
NEXT_PUBLIC_SITE_URL=

# --- Required for Phase 2 (database + admin auth) ---

# Postgres connection string (Neon in production — see PLAN.md §2).
# For local dev, any Postgres works, e.g.:
# postgresql://postgres:yourpassword@localhost:5432/1stcity_dev
DATABASE_URL=

# Random 32+ character secret Better Auth uses to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own base URL (used by Better Auth for callbacks/cookies).
BETTER_AUTH_URL=http://localhost:3000

# --- Optional — the app degrades gracefully without these ---

# SendGrid (https://sendgrid.com) API key used to email new vendor
# proposals, property/general inquiries, and staff password resets.
# Sent from a single verified sender (krystal.stinson@1stcityllc.com —
# see src/lib/email.ts) rather than a verified domain, since DNS access
# for 1stcityllc.com isn't available. Without this key, submissions are
# still saved to the database (visible in /admin) but not emailed, and
# password-reset links are logged to the server console instead.
SENDGRID_API_KEY=
VENDOR_NOTIFICATION_EMAIL=vendors@1stcityllc.example

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) read/write
# token for vendor-form attachments. Without it, uploads are skipped —
# the form still works, just without a stored attachment.
BLOB_READ_WRITE_TOKEN=

# reCAPTCHA v2 ("I'm not a robot" checkbox) keys for the general contact
# form (/contact) — get a site/secret key pair at
# https://www.google.com/recaptcha/admin for this domain (and localhost
# for dev). Without these, the form has no captcha and submits normally.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Seeding the first staff account (see prisma/seed.ts) ---
# Run once locally: npm run db:seed
# Leave unset to get a documented dev-only account instead.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
