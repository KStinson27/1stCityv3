# Copy to .env.local and fill in for local development.

# --- Required for Phase 2 (database + admin auth) ---

# Postgres connection string (Neon in production — see PLAN.md §2).
# For local dev, any Postgres works, e.g.:
# postgresql://postgres:yourpassword@localhost:5432/1stcity_dev
DATABASE_URL=

# Random 32+ character secret Better Auth uses to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own base URL (used by Better Auth for callbacks/cookies).
BETTER_AUTH_URL=http://localhost:3000

# --- Optional — the app degrades gracefully without these ---

# Resend (https://resend.com) API key used to email new vendor proposals
# and property inquiries to staff. Without it, submissions are still
# saved to the database (visible in /admin) but not emailed.
RESEND_API_KEY=
VENDOR_NOTIFICATION_EMAIL=vendors@1stcityllc.example

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) read/write
# token for vendor-form attachments. Without it, uploads are skipped —
# the form still works, just without a stored attachment.
BLOB_READ_WRITE_TOKEN=

# --- Seeding the first staff account (see prisma/seed.ts) ---
# Run once locally: npm run db:seed
# Leave unset to get a documented dev-only account instead.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
