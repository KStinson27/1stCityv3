generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum SubmissionStatus {
  NEW
  REVIEWED
  CONTACTED
  DECLINED
}

/// Staff-editable overlay for the descriptive/contact content of a
/// property. Once a row exists for a propertySlug, it is the full source
/// of truth for its fields (not a per-field fallback to the static
/// src/data/properties.ts values) so that clearing a field in the admin
/// UI actually clears it instead of resurrecting old code-managed copy.
model PropertyContent {
  propertySlug      String   @id
  description       String?
  amenities         String[]
  incomeLimits      Json?
  requiredDocuments String[]
  applyUrl          String?
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  updatedAt         DateTime @updatedAt

  @@map("property_content")
}

/// Staff-uploaded property photos (Vercel Blob). Any rows for a
/// propertySlug make the database the full photo set for that property;
/// zero rows falls back to the static photos array.
model PropertyPhoto {
  id           String   @id @default(cuid())
  propertySlug String
  url          String
  sortOrder    Int
  createdAt    DateTime @default(now())

  @@index([propertySlug])
  @@map("property_photo")
}

/// Shared, staff-uploaded documents (Vercel Blob), keyed by a fixed slug
/// rather than per-property — e.g. the one rental application form used
/// across all affordable-housing properties.
model SiteDocument {
  key       String   @id
  url       String
  fileName  String
  updatedAt DateTime @updatedAt

  @@map("site_document")
}

model VendorSubmission {
  id             String           @id @default(cuid())
  companyName    String
  contactName    String
  email          String
  phone          String?
  serviceType    String
  message        String
  attachmentUrl  String?
  attachmentName String?
  status         SubmissionStatus @default(NEW)
  internalNote   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@map("vendor_submission")
}

enum UnitAvailabilityStatus {
  AVAILABLE
  WAITLIST
  FULL
  CONTACT
}

/// Staff-editable overlay for the operationally volatile parts of a unit
/// (rent/availability/status). Unit *types* still come from the static
/// Property data in src/data/properties.ts — this only tracks per-unit-type
/// state for properties already defined there.
model UnitAvailability {
  id           String                 @id @default(cuid())
  propertySlug String
  unitType     String
  status       UnitAvailabilityStatus @default(CONTACT)
  rent         String?
  availability String?
  updatedAt    DateTime               @updatedAt

  @@unique([propertySlug, unitType])
  @@index([propertySlug])
  @@map("unit_availability")
}

/// Submissions from the general contact form (/contact) and the
/// per-property contact form (/properties/[slug]/contact). propertySlug/
/// propertyName are null for a general inquiry.
model ContactSubmission {
  id                String           @id @default(cuid())
  name              String
  email             String
  phone             String?
  message           String
  propertySlug      String?
  propertyName      String?
  preferredContact  String?
  status            SubmissionStatus @default(NEW)
  internalNote      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@map("contact_submission")
}
